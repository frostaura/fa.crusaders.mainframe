# /etc/court-box/court-box.env — court-brain's Linux-side settings.
# The club's settings are NOT here: they arrive in every heartbeat.

# Whose MAC is the box's identity on the admin Devices page, and which radio a
# server-sent `net` change drives.
COURT_BRAIN_IFACE=wlan0

# Keep the retired ESP8266's identity so its court numbers, button map and LCD
# settings carry over: its MAC is on the admin Devices page (and in the old box's
# heartbeat). Leave empty to register the Pi as a new device.
# NEVER run the old box and the Pi at the same time with the same MAC.
COURT_BRAIN_MAC=

# 1: the server's `net` drives nmcli (WiFi). 0: the OS owns the network
# (Ethernet — recommended where a cable reaches the box).
COURT_BRAIN_MANAGE_WIFI=1

# Paths (defaults shown).
#COURT_BRAIN_LINK=/run/court-box/link.sock
#COURT_BRAIN_DATA=/var/lib/court-box/brain
#COURT_BRAIN_RUN=/run/court-box
