# --- crusaders court box (court-pi) — appended to /boot/firmware/config.txt ---
# I2C1 on GPIO 2/3 for the LCD backpack, at 100 kHz: it sits behind a level
# shifter on a panel lead, and the HD44780 gains nothing from 400.
dtparam=i2c_arm=on
dtparam=i2c_arm_baudrate=100000
# The PL011 UART on GPIO 14/15 for the QR scanner (Pi 3 / 4 / Zero 2 W: the
# Bluetooth radio is moved off it; harmless on a Pi 5, whose uart0 is 14/15).
enable_uart=1
dtoverlay=disable-bt
# The SoC watchdog systemd feeds (court-box-watchdog.conf).
dtparam=watchdog=on
# Relays: INPUT with PULL-DOWN from the firmware stage, before Linux has even
# started — the same state the SoC reset leaves and the external resistors hold.
gpio=17,27,22,23=ip,pd
# Status LED off.
gpio=24=op,dl
# --- end crusaders court box ---
