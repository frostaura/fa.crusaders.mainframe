// Copy to secrets.h and fill before flashing. secrets.h is gitignored.
//
// The device identity and key are provisioned per box: the backend issues the
// device_id when the device is registered, and the key is derived from it. Two
// devices must never share these values.
#pragma once

#define WIFI_SSID       "ClubWiFi"
#define WIFI_PASSWORD   "REPLACE_ME"

// Registered in the admin panel under Devices. Not a secret on its own.
#define DEVICE_ID       "REPLACE_WITH_DEVICE_ID"

// Shared secret for request signing. Treat as a credential: it authorises relay
// control. Rotate by bumping DEVICE_KEY_VERSION and re-provisioning.
#define DEVICE_KEY      "REPLACE_WITH_DEVICE_KEY"
#define DEVICE_KEY_VERSION 1

// Backend base URL on the club LAN.
#define API_BASE_URL    "http://192.168.68.10:8088"
