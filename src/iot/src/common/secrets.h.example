// Copy to secrets.h and fill before flashing. secrets.h is gitignored.
//
// This header is OPTIONAL and carries exactly one thing: the club WiFi
// credential for a box's FIRST join. court_bridge/main.cpp includes it with
// __has_include and defaults both macros to "" when it is absent, which is how
// the CI-built image (the one every box installs over the air) is built with
// no credential at all. The credential is persisted to the box's flash store
// (bridgelogic::CredentialStore) the first time it actually joins, and every
// later boot and every OTA image reads it from there — so a box needs this
// header on at most one flash, ever.
//
// The alternative that needs no secrets.h and no rebuild: flash the plain
// image, set DIP 5 and 6 ON (ESP UART on the USB socket), open a serial
// monitor at 9600 8N1 and type
//
//     !WIFI,<ssid>,<password>
//
// The LCD answers WIFI SAVED. Use this to rotate the club password too.
#pragma once

#define WIFI_SSID       "ClubWiFi"
#define WIFI_PASSWORD   "REPLACE_ME"

// --------------------------------------------------------------------------
// NOT READ BY THE FIRMWARE. Kept here, commented out, only so an older copy of
// this file is recognisable. The device id and key come from the claim flow
// (POST /api/v1/device/provision after the admin enters the LCD claim code)
// and live in the flash store; the API base URL comes from the discovery OFFER
// or from provisioning. Nothing in src/iot reads these macros — grep for them.
// --------------------------------------------------------------------------
// #define DEVICE_ID          "unused"
// #define DEVICE_KEY         "unused"
// #define DEVICE_KEY_VERSION 1
// #define API_BASE_URL       "unused"
