// Copy to secrets.h and fill in before flashing. secrets.h is gitignored.
//
// This header is REQUIRED to build `court_bridge` and carries exactly one
// thing: the club WiFi credential. court_bridge/main.cpp `#error`s without it,
// deliberately — an image that joins an empty SSID looks identical to a working
// one until it is screwed to a wall, and there is no runtime way to correct it.
//
// There is no `!WIFI` provisioning line and no credential store on the box any
// more. To change the club WiFi password: edit the two values below and run
// `make flash-bridge`. See src/iot/README.md's Flashing section.
#pragma once

#define WIFI_SSID       "ClubWiFi"
#define WIFI_PASSWORD   "REPLACE_ME"

// --------------------------------------------------------------------------
// NOT READ BY THE FIRMWARE. Kept here, commented out, only so an older copy of
// this file is recognisable. The device id and key come from the claim flow
// (POST /api/v1/device/provision after the admin enters the LCD claim code)
// and live in the flash store; the API base URL comes from the discovery OFFER
// or from provisioning. Nothing in src/iot reads these macros — grep for them.
// --------------------------------------------------------------------------
// #define DEVICE_ID          "unused"
// #define DEVICE_KEY         "unused"
// #define DEVICE_KEY_VERSION 1
// #define API_BASE_URL       "unused"
