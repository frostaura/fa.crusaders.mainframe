// Copy to secrets.h — in THIS folder, beside door_gate.ino — and fill in all
// four values before flashing. secrets.h is
// gitignored.
//
// This header is REQUIRED to build `door_gate`, and every value in it is
// mandatory: main.cpp `#error`s on a missing one and `static_assert`s on an
// empty one. That is deliberate — an image that joins an empty SSID, or posts
// to an empty base URL with an empty bearer key, looks identical to a working
// one until it is screwed to a wall beside a door, and there is no runtime way
// to correct it.
//
// There is no discovery, no claim code, no provisioning call and no credential
// store on the board. To change any of these: edit the value and Upload again from
// the Arduino IDE. See src/iot/door-gate/arduino/README.md.
//
// THE SAME FOUR VALUES FOR EVERY DOOR. Nothing per-gate belongs in here: a door
// is named in the admin console (`gate_key`) and learns its own name from the
// heartbeat, so two doors run byte-identical images and a spare board is a
// spare board rather than a board for one particular door.
#pragma once

// The club WiFi. WPA2 personal; the board takes a DHCP lease and there is no
// static-IP option, deliberately — Carl's sketch hard-coded 192.168.68.151,
// which works exactly until somebody changes the router, the subnet, or fits a
// second door.
#define WIFI_SSID       "ClubWiFi"
#define WIFI_PASSWORD   "REPLACE_ME"

// Where the API is, with scheme and port and NO trailing slash. The board and
// the backend sit on the same club LAN, so this is normally the backend's LAN
// address — not the public tunnel hostname, which would send every scan out to
// Cloudflare and back while somebody stands at the door.
#define API_BASE_URL    "http://192.168.1.10:8088"

// The tenant's device API key, from the admin Devices page ("Regenerate" mints
// a new one and invalidates this one immediately, so a regeneration is a
// reflash of every board that carries it). It goes out as
// `Authorization: Bearer <key>` on every call.
//
// It matters even though the board never leaves the LAN: the same API is
// reachable from the internet through the Cloudflare tunnel, because that is
// how members book and how the admin works remotely.
#define DEVICE_API_KEY  "REPLACE_ME"
