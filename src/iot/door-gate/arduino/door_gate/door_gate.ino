namespace {

using namespace gatelogic;

esp32_hal::Esp32Clock gClock;
esp32_hal::Esp32Scanner gScanner;
esp32_hal::Esp32NvsStore gStore;
esp32_hal::Esp32Link gLink;
esp32_hal::Esp32Watchdog gWatchdog;
esp32_hal::Esp32PinOut gRelayPin(kGateConfig.relayPin);
esp32_hal::Esp32PinOut gLedPin(kGateConfig.ledPin);

/// This board's MAC as 12 lowercase hex characters, filled once at boot and
/// then read-only. It is the whole of the board's identity: it goes in the body
/// of every request, and an unknown one auto-registers a Gate row against the
/// key's tenant.
char gMacHex[dc::hex::encodedSize(6U)];

/// THIS BOOT'S IDENTITY, drawn once before the loop and never again.
///
/// The third field of the server's idempotency key — see `Ports::bootId` and
/// round G4's C2. `esp_random()` is the hardware RNG; it is seeded from RF
/// noise once the radio is up and from an entropy pool before that, and both
/// are far better than this needs to be. The requirement is only that two
/// consecutive boots of one board, and two boards that happen to share a MAC,
/// do not collide — not that anybody could not guess it. Nothing turns on it
/// being unpredictable: it is a de-duplication tag, not a credential.
///
/// NEVER ZERO. Zero is the wire's "this board has no boot identity", which
/// omits the field and gives the server the old (device, seq) behaviour, so a
/// one-in-four-billion draw of zero would silently put one boot of one board
/// back on the defect this exists to close.
uint32_t drawBootId() {
  const uint32_t drawn = esp_random();
  return drawn == 0U ? 1U : drawn;
}

uint32_t gBootId = drawBootId();

/// CONSECUTIVE WATCHDOG RESETS, ACROSS RESETS. See `gatelogic/BootRecovery.h`
/// for why a board needs to know.
///
/// `RTC_NOINIT_ATTR` puts it in RTC slow memory and tells the startup code NOT
/// to zero it, which is the only storage on this part that survives a reset
/// without wearing flash out — and a flash write per watchdog reset is exactly
/// the wrong thing to add to a board that is resetting in a loop. It does NOT
/// survive a power cycle, which is correct: somebody who pulled the power has
/// intervened, and the run should start again.
///
/// Uninitialised memory is uninitialised, so the first read after a POWER-ON
/// is whatever the RTC domain happened to hold. `nextResetRun` is fed a
/// `watchdogReset` of false on that boot and answers 0 regardless, so the
/// garbage never reaches the arithmetic — which is why the reset REASON is
/// read first and is not inferred from the counter.
RTC_NOINIT_ATTR uint32_t gWatchdogResetRun;

/// The run for THIS boot, computed once and written straight back.
///
/// `esp_reset_reason()` is the part's own account of why it restarted, and
/// `ESP_RST_TASK_WDT` is the task watchdog this firmware arms. `ESP_RST_WDT`
/// (the other watchdogs) and `ESP_RST_INT_WDT` are counted with it: all three
/// mean "something held this board and a timer ended it", which is the state
/// the backoff is for. A panic, a brownout, a power-on or a reflash are not.
uint32_t drawWatchdogResetRun() {
  const esp_reset_reason_t reason = esp_reset_reason();
  const bool watchdog = reason == ESP_RST_TASK_WDT || reason == ESP_RST_INT_WDT || reason == ESP_RST_WDT;
  gWatchdogResetRun = gatelogic::nextResetRun(watchdog, watchdog ? gWatchdogResetRun : 0U);
  return gWatchdogResetRun;
}

uint32_t gWatchdogResetRunThisBoot = drawWatchdogResetRun();

/// `Bearer <DEVICE_API_KEY>`, rendered once at boot. Held rather than rebuilt
/// per call because it is the same string for the life of the image and the
/// heap it would churn is shared with the network stack.
char gAuthHeader[devapi::kAuthorizationBufSize] = {};

esp32_hal::Esp32HttpPort gHttp(API_BASE_URL, gAuthHeader, gClock);
devlink::ApiBreaker gBreaker;
GateApi gApi(gHttp, gBreaker, gClock);

LockDriver gLock(gRelayPin, kGateConfig.relayActiveHigh, kGateConfig.unlockEnergisesRelay);
UnlockTimer gUnlock(kGateConfig.unlockHardCapMs, kGateConfig.minRelockMs, kGateConfig.relockDwellMs);
LedPattern gLed;
ScanAssembler gAssembler;
ScanDebounce gDebounce;

GateQueue gQueue(&gStore);
GateRoster gRoster(kGateConfig.rosterMaxAgeMs);

/// The heartbeat response. File scope, not stack: the contract allows 4096
/// bytes — 48 roster entries plus a 64-character slug and gate key — and a 4.6
/// KB local under a blocking HTTP call is a crash that reads as a random reset.
char gHeartbeatBody[kGateResponseCap] = {};

/// Every port the loop needs, named. Assigned rather than aggregate-initialised
/// because two pointers of the same type swapped positionally is a build that
/// compiles and a door that blinks when it should open.
GateApp::Ports wire() {
  GateApp::Ports ports;
  ports.clock = &gClock;
  ports.scanner = &gScanner;
  ports.watchdog = &gWatchdog;
  ports.link = &gLink;
  ports.api = &gApi;
  ports.breaker = &gBreaker;
  ports.lock = &gLock;
  ports.unlock = &gUnlock;
  ports.led = &gLed;
  ports.ledPin = &gLedPin;
  ports.ledActiveHigh = kGateConfig.ledActiveHigh;
  ports.assembler = &gAssembler;
  ports.debounce = &gDebounce;
  ports.roster = &gRoster;
  ports.queue = &gQueue;
  // NULL, AND IT HAS TO BE. `IDecisionLog` is the simulator's console; this
  // board has one LED and a USB line nobody is standing at. Written out rather
  // than left to the default so the shipped value is visible beside every other
  // port — and `GateApp` is host-tested on exactly this null path, because it
  // is the one that ships.
  ports.log = nullptr;
  ports.mac = gMacHex;
  ports.firmwareVersion = fw::kFirmwareVersion;
  ports.bootId = gBootId;
  ports.watchdogResetRun = gWatchdogResetRunThisBoot;
  ports.heartbeatBody = gHeartbeatBody;
  ports.heartbeatBodyCap = sizeof(gHeartbeatBody);
  return ports;
}

GateApp gApp(wire());

/// Learns this board's MAC and renders the one header every call carries.
///
/// The MAC is available before the radio associates — it is a fact about the
/// part, not about the link — so this runs early in setup() and everything
/// afterwards can assume both are filled. `wire()` captured the ADDRESS of
/// gMacHex, so filling it here is what the loop reads.
void setupIdentity() {
  uint8_t mac[6] = {0U, 0U, 0U, 0U, 0U, 0U};
  WiFi.macAddress(mac);
  static_cast<void>(dc::hex::encodeLower(mac, sizeof(mac), gMacHex, sizeof(gMacHex)));
  static_cast<void>(devapi::renderAuthorization(gAuthHeader, sizeof(gAuthHeader), DEVICE_API_KEY));
}

/// ONE line, at boot, on the USB console — and nothing in the loop.
///
/// The only other feedback surface on this board is a single LED, so a board
/// whose watchdog did not take, or whose MAC nobody can read off the Devices
/// page, is otherwise indistinguishable from a healthy one. README.md and the
/// sketch's own README both tell the person flashing it to open the monitor at
/// 115200; this is what is waiting for them.
void bootLog(bool watchdogArmed) {
  Serial.begin(115200);
  Serial.println();
  Serial.print(F("crusaders door-gate "));
  Serial.print(fw::kFirmwareVersion);
  Serial.print(F(" mac="));
  Serial.print(gMacHex);
  Serial.print(F(" api="));
  Serial.print(F(API_BASE_URL));
  Serial.print(F(" watchdog="));
  Serial.print(static_cast<int>(kGateConfig.watchdogSeconds));
  Serial.print(watchdogArmed ? F("s") : F("s NOT ARMED — esp_task_wdt refused"));
  // THE ONE LINE THAT EXPLAINS A BOARD IN TROUBLE. A reset loop scrolls this
  // past once a cycle and there is no other surface on this hardware that could
  // carry it — one LED cannot say "the API is dribbling headers at me". The run
  // and the hold are printed always, so a healthy board's line shows 0 and 0
  // and a technician has something to compare against.
  Serial.print(F(" wdt_reset_run="));
  Serial.print(static_cast<unsigned>(gWatchdogResetRunThisBoot));
  Serial.print(F(" first_call_held_ms="));
  Serial.println(static_cast<unsigned long>(gatelogic::firstCallDelayMs(gWatchdogResetRunThisBoot)));
}

} // namespace

void setup() {
  // FIRST, before anything else can take time or fail. Both output pins get
  // their level written into the output register before the pin drives it — the
  // lock LOCKED, the lamp dark — so the relay's first instruction is the one
  // that keeps the door shut. Every boot runs this, including the ones a
  // watchdog reset causes at 3am.
  gApp.beginOutputs();

  // Retried inside begin(); false here means three attempts all refused. The
  // board still runs and still opens doors — a door that admits nobody is far
  // worse than one on the core's five seconds — but it says so, on the boot
  // line below and on the lamp for as long as it is true.
  const bool watchdogArmed = gWatchdog.begin(kGateConfig.watchdogSeconds);
  gApp.setWatchdogArmed(watchdogArmed);

  // The receive buffer and the error callback are set inside this, before the
  // driver is installed, because afterwards both are ignored.
  gScanner.begin(kGateConfig.scannerBaud, kGateConfig.scannerRxPin, kGateConfig.scannerTxPin);
  static_cast<void>(gStore.begin());

  // The credential is the compiled-in one and nothing else — persistent(false)
  // keeps the core from writing a second, invisible copy in its own flash
  // record, which would outlive a reflash and join the wrong network.
  // DHCP: no WiFi.config(), no static address — see the header.
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  setupIdentity();
  bootLog(watchdogArmed);

  // The logical boot: the uptime seeded, the assembler emptied, the first
  // heartbeat armed, the queue opened and a `boot` event in it.
  gApp.begin();
}

void loop() {
  gApp.pass();

  // The only delay in this firmware. Ten milliseconds is invisible at a door
  // and is what keeps the ESP32's own housekeeping tasks scheduled.
  delay(kIdleDelayMs);
}
