# The native device simulator, containerised.
#
# A build stage and a runtime stage, because the PlatformIO toolchain is around a
# gigabyte and the thing it produces is a single static-ish binary. The runtime image
# carries the binary and nothing else.

# The build context is src/iot — the PARENT of this project — because the
# simulator compiles the shared libraries in ../shared/lib as well as this
# project's own. A context rooted at court-box/ would be missing half the sources.
FROM python:3.12-slim AS build
WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential git \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN pio run -d court-box -e simulator \
 && cp court-box/.pio/build/simulator/program /out-simulator

FROM debian:bookworm-slim
RUN useradd --create-home --uid 10001 simulator
COPY --from=build /out-simulator /usr/local/bin/simulator
USER simulator
EXPOSE 5555
ENTRYPOINT ["/usr/local/bin/simulator"]
