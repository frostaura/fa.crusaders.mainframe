// Copy to secrets.h — in THIS folder, beside court_bridge.ino — and fill in all
// six values before flashing. secrets.h is
// gitignored.
//
// This header is REQUIRED to build `court_bridge`, and every value in it is
// mandatory: main.cpp `#error`s on a missing one and `static_assert`s on an
// empty, malformed or placeholder one.
//
// THE FIRST FOUR ARE FIRST-BOOT DEFAULTS ONLY (bridge 3.1.0, the last cable
// flash). After the first accepted heartbeat the box keeps what the server
// sends — a rotated device key (`key_next`), a new WiFi or server address
// (`net`) — in its own flash, and the setup portal (hold court A and court D
// together for five seconds within 60 s of power-on) changes them at the box.
// Nothing an operator does needs this file again. To change the IMAGE, sign a
// release with src/iot/tools/ota_sign.py and upload it on the admin Firmware
// panel. See
// src/iot/court-box/arduino/README.md.
#pragma once

// The club WiFi. WPA2 personal; the box takes a DHCP lease and there is no
// static-IP option, deliberately.
#define WIFI_SSID       "ClubWiFi"
#define WIFI_PASSWORD   "REPLACE_ME"

// Where the API is, with scheme and port and NO trailing slash. The box and the
// backend sit on the same club LAN, so this is normally the backend's LAN
// address — not the public tunnel hostname, which would send every scan out to
// Cloudflare and back for no reason. `http://` only: the box cannot open TLS.
#define API_BASE_URL    "http://192.168.1.10:8088"

// The tenant's device API key (k0), from the admin Devices page. A rotation
// reaches the box over the heartbeat; it goes out as `Authorization: Bearer
// <key>` on every call.
//
// It matters even though the box never leaves the LAN: the same API is reachable
// from the internet through the Cloudflare tunnel, because that is how members
// book and how the admin works remotely.
#define DEVICE_API_KEY  "REPLACE_ME"

// The RELEASE key's RSA-2048 modulus, 512 hex characters, from
// `python3 src/iot/tools/ota_sign.py modulus --key <private key file>`. The box
// boots only images signed with its private half, which only the founder holds.
// The build refuses the contract corpus's test keys.
#define OTA_PUBLIC_KEY_N "REPLACE_ME_OTA_PUBLIC_KEY_N"

// The setup portal's WPA2 password (8-63 characters). Print it on the label
// inside the enclosure: it is what a technician types to join
// CRUSADERS-SETUP-<last four of the MAC>.
#define SETUP_AP_PASSWORD "REPLACE_ME_SETUP_AP_PASSWORD"
