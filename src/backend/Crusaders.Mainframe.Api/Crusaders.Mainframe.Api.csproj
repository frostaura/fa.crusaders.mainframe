<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Crusaders.Mainframe.Api</RootNamespace>
    <AssemblyName>Crusaders.Mainframe.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" Version="3.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Lifts a transitive pin, not a dependency of ours: EF Core Design pulls MSBuild
         (Microsoft.Build.Tasks.Core), which asks for System.Security.Cryptography.Pkcs 9.0.0 —
         flagged high (GHSA-846f-f764-76mx) and failing the Security Scan. Drop this once the
         EF Design / MSBuild chain itself asks for a patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crusaders.Mainframe.Tests" />
  </ItemGroup>

</Project>
