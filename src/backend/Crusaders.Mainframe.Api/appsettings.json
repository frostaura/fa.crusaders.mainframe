{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "_comment_ConnectionStrings": "Development placeholder. Override via ConnectionStrings__DefaultConnection env var in all non-local environments.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=crusaders_mainframe;Username=postgres;Password=REPLACE_WITH_LOCAL_DB_PASSWORD"
  },
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "Jwt": {
    "Secret": "DEV_ONLY_REPLACE_WITH_SECURE_JWT_SECRET_VALUE_32_CHARS_MIN",
    "Issuer": "crusaders.mainframe",
    "Audience": "crusaders.mainframe.app",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "User": "",
    "Password": "",
    "From": "noreply@crusadersmainframe.local",
    "FromName": "Crusaders Mainframe"
  },
  "App": {
    "FrontendUrl": "http://localhost:8088",
    "PublicBaseUrl": "http://localhost:8088"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8088", "http://localhost:4173" ]
  },
  "Media": {
    "StoragePath": "./media"
  },
  "Tenancy": {
    "_comment": "ResolveFrom: 'host' = subdomain (foo.example.com), 'header' = X-Tenant header, 'jwt' = JWT claim. Default chain: jwt then host.",
    "ResolveFromOrder": [ "jwt", "host" ],
    "DefaultTenantSlug": "crusaders"
  },
  "Biometric": {
    "Driver": "Null",
    "TemplateStorePath": "./biometric/templates"
  },
  "Lights": {
    "DefaultControllerSecret": "REPLACE_AT_TENANT_SETUP"
  },
  "PeachPayments": {
    "BaseUrl": "https://test.oppwa.com"
  }
}
