{
  "description": "Offline verification as a device performs it: StepClock from the sync, the day slots and keys as a heartbeat delivered them, then scans in order. `commit` says whether the caller then acted (lit a court, released a door) and recorded the use in the replay ring.",
  "step_ms": 30000,
  "window": 1,
  "default_max_age_ms": 21600000,
  "scenarios": [
    {
      "id": "accept-then-replay",
      "note": "a code is accepted once; a second presentation of the same step, or of an earlier one, is a replay — the ring keeps the highest step per REF",
      "sync": {
        "step": 59672640,
        "step_ms": 17000,
        "at_ms": 1000000
      },
      "days": [
        "59670480|59673360"
      ],
      "keys": [
        "18Y90HkE5WHvWQ0Oe9Rdl",
        "BWDJ0IksrpX8Aq55NF6dh"
      ],
      "replay_capacity": 4,
      "scans": [
        {
          "at_ms": 1005000,
          "token": "118Y956008441714835",
          "expect": "ok",
          "ref": "18Y9",
          "step": 59672640,
          "commit": true
        },
        {
          "at_ms": 1010000,
          "token": "118Y956008441714835",
          "expect": "replayed",
          "ref": "18Y9",
          "step": 59672640,
          "commit": false
        },
        {
          "at_ms": 1010000,
          "token": "118Y950663370515394",
          "expect": "replayed",
          "ref": "18Y9",
          "step": 59672639,
          "commit": false
        },
        {
          "at_ms": 1010000,
          "token": "118Y925437688407038",
          "expect": "ok",
          "ref": "18Y9",
          "step": 59672641,
          "commit": true,
          "note": "a phone one step fast, inside the window"
        },
        {
          "at_ms": 1011000,
          "token": "1BWDJ22225228938905",
          "expect": "ok",
          "ref": "BWDJ",
          "step": 59672640,
          "commit": true,
          "note": "another member's use is independent"
        }
      ]
    },
