      ],
      "expect": [
        {
          "frame": {
            "verb": "ON",
            "args": [
              "A",
              "1"
            ]
          }
        }
      ]
    },
    {
      "id": "dec-on-without-duration-is-refused",
      "kind": "decode",
      "note": "THE safety case. There is no ON frame without a duration, on the wire or in the API, so this line cannot become a relay command.",
      "link": "downlink",
      "chunks": [
