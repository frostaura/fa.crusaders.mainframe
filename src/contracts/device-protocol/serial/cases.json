      "id": "dec-crlf-is-one-terminator",
      "kind": "decode",
      "note": "Two results here would mean every frame from a CRLF peer produced a spurious empty line.",
      "link": "downlink",
      "chunks": [
        "!RST*55\r\n"
      ],
      "expect": [
        {
          "frame": {
            "verb": "RST",
            "args": []
          }
        }
      ]
    },
