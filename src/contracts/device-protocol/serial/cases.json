{
  "description": "ATmega2560 <-> ESP8266 line protocol: encode cases (Frame -> exact bytes) and decode cases (bytes -> Frames or errors). Read by src/iot/test/test_protocol. Checksums here were produced by an independent Python XOR, not by the codec under test.",
  "authority": "docs/specs/device-serial-protocol.md",
  "encode": [
    {
      "id": "enc-on",
      "kind": "encode_v2",
      "frame": {
        "verb": "ON",
        "args": [
          "A",
          "1800"
        ]
      },
      "cap": 4096,
      "bytes": "!ON,A,1800*49\n"
    },
    {
      "id": "enc-on-clamp-high",
      "kind": "encode_v2",
      "note": "A caller asking for 16 hours gets the 90-minute hard cap, not a rejection.",
      "frame": {
        "verb": "ON",
        "args": [
          "D",
          "60000"
        ]
      },
      "cap": 4096,
      "bytes": "!ON,D,5400*44\n"
    },
    {
      "id": "enc-on-clamp-low",
      "kind": "encode_v2",
      "note": "Zero seconds would be an indefinite-on by another name; it clamps up to 1.",
      "frame": {
        "verb": "ON",
        "args": [
          "B",
          "0"
        ]
      },
      "cap": 4096,
      "bytes": "!ON,B,1*72\n"
    },
