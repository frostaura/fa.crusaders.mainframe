  "decode": [
    {
      "id": "dec-on",
      "kind": "decode",
      "link": "downlink",
      "chunks": [
        "!ON,A,1800*49\n"
      ],
      "expect": [
        {
          "frame": {
            "verb": "ON",
            "args": [
              "A",
              "1800"
            ]
          }
        }
      ]
    },
    {
      "id": "dec-on-clamp-high",
      "kind": "decode",
      "note": "Clamped, never rejected: a clamped light is a wrong-length game, a rejected one is a dark court.",
      "link": "downlink",
      "chunks": [
        "!ON,A,99999*79\n"
      ],
      "expect": [
        {
          "frame": {
            "verb": "ON",
            "args": [
              "A",
              "5400"
            ]
          }
        }
      ]
    },
    {
      "id": "dec-on-clamp-absurd",
      "kind": "decode",
      "note": "Saturating, not wrapping. A value that overflows uint32 must become the hard cap, not a small number.",
      "link": "downlink",
      "chunks": [
        "!ON,B,99999999999*7A\n"
      ],
      "expect": [
        {
          "frame": {
            "verb": "ON",
            "args": [
              "B",
              "5400"
            ]
          }
        }
      ]
    },
    {
