    {
      "id": "enc-max-length-frame",
      "kind": "encode_v2",
      "note": "The longest frame any named constructor can produce: two full-width arguments of entirely escapable bytes. 154 bytes, comfortably inside kMaxFrameLen.",
      "frame": {
        "verb": "LCD",
        "args": [
          ",,,,,,,,,,,,,,,,,,,,,,,,",
          "%%%%%%%%%%%%%%%%%%%%%%%%"
        ]
      },
      "cap": 4096,
      "bytes": "!LCD,%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C%2C,%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25%25*4B\n"
    },
    {
      "id": "enc-refuses-to-truncate",
      "kind": "encode_v2",
      "note": "A truncated relay command is worse than none, so a frame that will not fit emits ZERO bytes rather than a prefix.",
