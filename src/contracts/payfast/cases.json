{
  "description": "PayFast MD5 signature: PHP-urlencode-compatible parameter string plus an optional passphrase.",
  "authority": "PayFast developer documentation. Generated by an independent Python implementation; C# must match it byte for byte.",
  "warning": "NOT verified against PayFast's live sandbox — no sandbox credentials were available. This proves conformance to the documented algorithm, not to PayFast's production behaviour. The first live transaction is still a real milestone.",
  "passphrase": "not-a-real-passphrase-test-fixture-only",
  "encode": [
    {
      "raw": "abc123",
      "note": "alphanumeric — untouched everywhere",
      "encoded": "abc123"
    },
    {
      "raw": "Court 1 booking",
      "note": "SPACES become '+', not %20. .NET's EscapeDataString emits %20.",
      "encoded": "Court+1+booking"
    },
    {
      "raw": "a-b_c.d",
      "note": "PHP's safe set: - _ . stay literal",
      "encoded": "a-b_c.d"
    },
    {
      "raw": "tilde~here",
      "note": "'~' IS escaped by PHP urlencode. .NET and Python leave it literal — the single most likely mismatch.",
      "encoded": "tilde%7Ehere"
    },
    {
      "raw": "a+b",
      "note": "a literal plus must encode to %2B or it reads back as a space",
      "encoded": "a%2Bb"
    },
    {
      "raw": "50% off",
      "note": "percent and space together",
      "encoded": "50%25+off"
    },
    {
      "raw": "a&b=c",
      "note": "separators inside a value must not survive as separators",
      "encoded": "a%26b%3Dc"
    },
    {
      "raw": "R100.00",
      "note": "a money string",
      "encoded": "R100.00"
    },
    {
      "raw": "café",
      "note": "multi-byte UTF-8 — encoded per byte, not per character",
      "encoded": "caf%C3%A9"
    },
    {
      "raw": "Ünïcödé Cøürt",
      "note": "multi-byte with spaces",
      "encoded": "%C3%9Cn%C3%AFc%C3%B6d%C3%A9+C%C3%B8%C3%BCrt"
    },
    {
      "raw": "line\nbreak",
      "note": "control character",
      "encoded": "line%0Abreak"
    },
    {
      "raw": "quote\"and'apos",
      "note": "quotes",
      "encoded": "quote%22and%27apos"
    },
    {
      "raw": "slash/and\\back",
      "note": "slashes",
      "encoded": "slash%2Fand%5Cback"
    },
    {
      "raw": "@:,;?[]",
      "note": "reserved characters .NET leaves alone in some overloads",
      "encoded": "%40%3A%2C%3B%3F%5B%5D"
    },
    {
      "raw": "  leading and trailing  ",
      "note": "whitespace is significant and must not be trimmed",
      "encoded": "++leading+and+trailing++"
    }
  ],
