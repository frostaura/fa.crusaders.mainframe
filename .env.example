# Crusaders Mainframe — Environment Variables
# Copy to .env and fill in values before running docker compose up.

# ============================================================================
# Postgres
# ============================================================================
POSTGRES_USER=crusaders
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=crusaders_mainframe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# Backend API
# ============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=crusaders_mainframe;Username=crusaders;Password=REPLACE_WITH_STRONG_DB_PASSWORD
Database__AutoMigrateOnStartup=true
APP_FRONTEND_URL=http://localhost:8088
APP_PUBLIC_BASE_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:4173,https://localhost:4173
MEDIA_STORAGE_PATH=/app/media

# ============================================================================
# JWT / Auth
# ============================================================================
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_VALUE
JWT_ISSUER=crusaders.mainframe
JWT_AUDIENCE=crusaders.mainframe.app
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================================================
# WebAuthn / Passkeys
# ============================================================================
WEBAUTHN_ORIGIN=http://localhost:8088,http://localhost:4173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Crusaders Mainframe

# ============================================================================
# Multi-tenancy
# ============================================================================
# Wraps per-tenant data-encryption keys (stored encrypted in tenant_secrets).
MASTER_SECRETS_ENCRYPTION_KEY=REPLACE_WITH_MIN_32_CHAR_KMS_KEY

# ============================================================================
# SMTP (email — verification, magic-link, receipts, no-show notices)
# ============================================================================
# Local dev uses the same FrostAura GoDaddy SMTP as fa.startup (see fa.startup/.env).
# Override SMTP_HOST=mailhog + SMTP_PORT=1025 to route to MailHog instead of real outbound.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=dean.martin@frostaura.net
SMTP_PASSWORD=REPLACE_FROM_FA_STARTUP_DOTENV
SMTP_FROM=mainframe@frostaura.net
SMTP_FROM_NAME=Crusaders Mainframe
MAILHOG_UI_PORT=8025

# ============================================================================
# PeachPayments (per-tenant overrides live in DB; these are platform defaults)
# ============================================================================
# test.oppwa.com for sandbox, oppwa.com for production
PEACH_PAYMENTS_BASE_URL=https://test.oppwa.com

# ============================================================================
# Biometric peripheral (driver picked when hardware is in hand)
# ============================================================================
# Switch to 'Vendor' once a real driver is added.
BIOMETRIC_DRIVER=Null
BIOMETRIC_TEMPLATE_STORE_PATH=/app/biometric/templates

# ============================================================================
# Lights controller (Arduino) — shared secret expected in every webhook body
# ============================================================================
LIGHTS_CONTROLLER_DEFAULT_SECRET=REPLACE_AT_TENANT_SETUP

# ============================================================================
# Frontend (Vite)
# ============================================================================
VITE_API_TARGET=http://localhost:5238
VITE_DEV_PORT=4173
VITE_API_BASE_PATH=
FROSTAURA_LOCAL_HOST=localhost
FROSTAURA_API_PORT=5238

# ============================================================================
# Gateway (nginx reverse proxy in compose)
# ============================================================================
GATEWAY_PORT=8088
NGINX_BACKEND_PORT=5000
NGINX_FRONTEND_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=10m

# ============================================================================
# Portainer deploy (used only by CI)
# ============================================================================
PORTAINER_URL=https://portainer.example.local
PORTAINER_TOKEN=ptr_generate_a_dedicated_ci_user_access_token
PORTAINER_ENDPOINT_ID=1
PORTAINER_STACK_ID=1
