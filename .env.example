# Crusaders Mainframe — Environment Variables
# Copy to .env and fill in values before running docker compose up.

# ============================================================================
# Postgres
# ============================================================================
POSTGRES_USER=crusaders
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=crusaders_mainframe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# Backend API
# ============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=crusaders_mainframe;Username=crusaders;Password=REPLACE_WITH_STRONG_DB_PASSWORD
Database__AutoMigrateOnStartup=true
APP_FRONTEND_URL=http://localhost:8088
APP_PUBLIC_BASE_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:4173,https://localhost:4173
MEDIA_STORAGE_PATH=/app/media

# ============================================================================
# JWT / Auth
# ============================================================================
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_VALUE
JWT_ISSUER=crusaders.mainframe
JWT_AUDIENCE=crusaders.mainframe.app
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================================================
# WebAuthn / Passkeys
# ============================================================================
WEBAUTHN_ORIGIN=http://localhost:8088,http://localhost:4173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Crusaders Mainframe

# ============================================================================
# Multi-tenancy
# ============================================================================
# Wraps per-tenant data-encryption keys (stored encrypted in tenant_secrets).
MASTER_SECRETS_ENCRYPTION_KEY=REPLACE_WITH_MIN_32_CHAR_KMS_KEY

# ============================================================================
# SMTP (email — verification, magic-link, receipts, no-show notices)
# ============================================================================
# Local dev uses the same FrostAura GoDaddy SMTP as fa.startup (see fa.startup/.env).
# Override SMTP_HOST=mailhog + SMTP_PORT=1025 to route to MailHog instead of real outbound.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=dean.martin@frostaura.net
SMTP_PASSWORD=REPLACE_FROM_FA_STARTUP_DOTENV
SMTP_FROM=mainframe@frostaura.net
SMTP_FROM_NAME=Crusaders Mainframe
MAILHOG_UI_PORT=8025

# ============================================================================
# PayFast (per-tenant merchant credentials live in tenant_settings.payfast)
# ============================================================================
# test.oppwa.com for sandbox, oppwa.com for production
# No platform-level PayFast URL: the sandbox/live host is chosen per tenant from
# tenant_settings.payfast.environment, so a club can go live independently.

# ============================================================================
# Biometric peripheral (driver picked when hardware is in hand)
# ============================================================================
# Switch to 'Vendor' once a real driver is added.
BIOMETRIC_DRIVER=Null
BIOMETRIC_TEMPLATE_STORE_PATH=/app/biometric/templates

# ============================================================================
# Lights controller (Arduino) — shared secret expected in every webhook body
# ============================================================================
LIGHTS_CONTROLLER_DEFAULT_SECRET=REPLACE_AT_TENANT_SETUP

# ============================================================================
# Court-box OTA firmware catalogue (deployment-wide, NOT a tenant setting)
# ============================================================================
# Leave these unset in the normal case. The API image built by CI carries the
# signed court_bridge image and its manifest at /app/firmware/ (the `iot-sign`
# job — see docs/specs/deployment.md), and Ota:Stable falls back to that baked
# manifest. Set these only to OVERRIDE the baked manifest — e.g. to hold the
# fleet on a previous image hosted elsewhere while a regression is investigated.
# Url is what the box fetches: relative to this API (/firmware/...) or absolute — and
# always http: the box cannot do TLS. ALL THREE keys are required together, with the
# real byte count of the image (`wc -c < court_bridge.signed.bin`): a partially set
# section is a STARTUP ERROR, because a half-configured override used to be discarded
# silently and the fleet took the baked image the override was meant to hold back.
# The signing key itself is a GitHub secret (OTA_PRIVATE_KEY), never an env var here.
#Ota__Stable__Version=1.0.0
#Ota__Stable__Url=http://192.168.68.20:8088/firmware/court_bridge-1.0.0.signed.bin
#Ota__Stable__SizeBytes=402176
# Optional canary channel; falls back to Stable when unset. Same all-or-nothing rule.
#Ota__Canary__Version=
#Ota__Canary__Url=
#Ota__Canary__SizeBytes=

# ============================================================================
# Frontend (Vite)
# ============================================================================
VITE_API_TARGET=http://localhost:5238
VITE_DEV_PORT=4173
VITE_API_BASE_PATH=
FROSTAURA_LOCAL_HOST=localhost
FROSTAURA_API_PORT=5238

# ============================================================================
# Gateway (nginx reverse proxy in compose)
# ============================================================================
# The API rebuilds the client address, scheme and host from X-Forwarded-* headers, but
# ONLY from a proxy it trusts. Default: loopback + the docker bridge pools
# (127.0.0.1, ::1, 172.16.0.0/12), which is where the compose gateway stands in both
# compose files. Override (indexed list) only if the API is fronted by something else:
#Gateway__TrustedProxies__0=127.0.0.1
#Gateway__TrustedProxies__1=172.16.0.0/12
# Per-address ceiling on anonymous /firmware/ downloads (one per box per release).
#RateLimits__FirmwarePerMinute=10
# An https DISCOVERY_ADVERTISED_BASE_URL refuses to start: the court box cannot fetch
# over TLS. Set this only to have the scheme rewritten to http (logged at startup).
#Discovery__DowngradeHttpsAdvertisedBaseUrl=false
GATEWAY_PORT=8088
NGINX_BACKEND_PORT=5000
NGINX_FRONTEND_PORT=80
NGINX_CLIENT_MAX_BODY_SIZE=10m

# ============================================================================
# Portainer deploy (used only by CI)
# ============================================================================
PORTAINER_URL=https://portainer.example.local
PORTAINER_TOKEN=ptr_generate_a_dedicated_ci_user_access_token
PORTAINER_ENDPOINT_ID=1
PORTAINER_STACK_ID=1
